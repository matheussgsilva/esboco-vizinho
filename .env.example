# Copiar para .env e preencher os valores reais. Nunca commitar o .env preenchido.

# Prisma Postgres (obtido no Prisma Console ou na integração Vercel Marketplace)
DATABASE_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"

# NextAuth / Auth.js
AUTH_SECRET="" # gerar com: npx auth secret
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (opcional, provider adicional para consumidores)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Esboço Páginas Amarelas <onboarding@resend.dev>"

# Stripe (usar chave restrita "rk_" com permissões mínimas em produção)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_BASIC=""
STRIPE_PRICE_PRO=""

# URL pública da aplicação (usada em redirects do Stripe Checkout/Billing Portal)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
