# Copiar para .env e preencher os valores reais. Nunca commitar o .env preenchido.

# Produção: Prisma Postgres (obtido no Prisma Console, aba "Connect", ou na integração
# Vercel Marketplace). São DUAS connection strings do mesmo banco — usar a errada em
# cada uma já causou "FATAL: too many connections for role prisma_migration" no build
# da Vercel (tráfego da aplicação esgotando a cota pequena de conexões diretas):
# - DATABASE_URL: connection string POOLED (host pooled.db.prisma.io) — usada em
#   runtime pela aplicação (src/lib/prisma.ts), preparada para muitas conexões
#   concorrentes de instâncias serverless.
# - DIRECT_URL: connection string DIRETA (host db.prisma.io) — usada só pela CLI do
#   Prisma (migrate/db push/studio, via prisma.config.ts), nunca pela aplicação.
# Desenvolvimento local: `docker compose up -d` sobe um Postgres local (ver docker-compose.yml)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/esboco_paginas_amarelas"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5433/esboco_paginas_amarelas"
DATABASE_URL="postgres://user:password@pooled.db.prisma.io:5432/postgres?sslmode=require"
DIRECT_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"

# NextAuth / Auth.js
AUTH_SECRET="" # gerar com: npx auth secret
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (opcional, provider adicional para consumidores)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Esboço Páginas Amarelas <onboarding@resend.dev>"

# Stripe (usar chave restrita "rk_" com permissões mínimas em produção)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_BASIC=""
STRIPE_PRICE_PRO=""

# URL pública da aplicação (usada em redirects do Stripe Checkout/Billing Portal)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Cron (fecha vagas expiradas — ver vercel.json e src/app/api/cron/close-expired-jobs)
# A Vercel envia automaticamente "Authorization: Bearer $CRON_SECRET" nas chamadas de cron
# quando essa env var está configurada no projeto. Gerar um valor aleatório (ex: openssl rand -hex 32).
CRON_SECRET=""
